# Nazia Botanics: environment variable template (safe to commit; NO real values here)
# Real values live in .env.local (local) and in Vercel > Project > Settings > Environment Variables.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string we generate; protects scheduled endpoints
CRON_SECRET=

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses database security
SUPABASE_SERVICE_ROLE_KEY=

# --- Flutterwave (Settings > API Keys; Settings > Webhooks) ---
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
# A random string we create, pasted into the Secret hash field on the Webhooks page
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Resend (API Keys; the sending domain must be verified in DNS) ---
RESEND_API_KEY=
EMAIL_FROM="Nazia Botanics <orders@notify.naziabotanics.com>"
# Where customer replies go (a real inbox you read). Leave empty to skip.
EMAIL_REPLY_TO=

# --- Mux (Settings > Access Tokens; Settings > Webhooks) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- Mapbox (account.mapbox.com > Tokens; style from Mapbox Studio > Share) ---
# Browser token, URL-restricted to the site's domains in production
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-only token, public scopes, no URL restriction
MAPBOX_SERVER_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# --- Upstash Redis (database > REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- PostHog (Settings > Project) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Phase 2 (leave empty for now) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
SHIPBUBBLE_API_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
